# ローカル開発。docker compose の Postgres は 5433 に出している(既存の5432と衝突させないため)
DATABASE_URL=postgres://lms:lms@localhost:5433/lms

# 段4.1(壊れている状態)で使う公開バケットのURL。段5で公開をやめるので、そこで不要になる。
R2_PUBLIC_BASE=https://pub-920849089a154b709a891b123d69a3e0.r2.dev

# 段5の署名鍵。Worker側は wrangler secret put SIGNING_SECRET で入れる。
SIGNING_SECRET=<openssl rand -base64 32 で生成>
